{
  "name": "ui-http-mock",
  "version": "1.0.0",
  "description": "Mocking http calls for UI development",
  "license": "ISC",
  "author": "Jenya Shvartsman",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "ui-http-mock": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "http",
    "mock",
    "server",
    "api",
    "development",
    "cli"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:help": "tsx src/index.ts --help",
    "dev:port:3000": "tsx src/index.ts --port 3000",
    "dev:mocks:data": "tsx src/index.ts --mock-dir ./data",
    "dev:prefix:api": "tsx src/index.ts --prefix /api",
    "dev:delay:500": "tsx src/index.ts --delay 500",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {}
}
